# ==============================================================================
# ACADEMIC ERP - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# 1. NextAuth / Auth.js Secret
# Generate a secret via: `openssl rand -base64 32` or type any secure random string
AUTH_SECRET=your_nextauth_secret_here_replace_me

# Optional: NextAuth URL (Vercel automatically sets this in production)
# NEXTAUTH_URL=http://localhost:3000

# 2. Google OAuth 2.0 Credentials (from Google Cloud Console)
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# 3. Administrator Gmail Whitelist (Comma-separated)
# Users logging in with these Gmail addresses automatically receive ADMIN privileges
ADMIN_EMAILS=sureshmagnolia@gmail.com,admin@college.edu

# 4. Database Connection (PostgreSQL)
# When deploying on Vercel, simply click "Storage > Create Database > Postgres"
# and click "Connect to Project". Vercel will automatically inject this variable!
# POSTGRES_URL=postgres://default:xxx@ep-xxx.neon.tech/verceldb?sslmode=require
